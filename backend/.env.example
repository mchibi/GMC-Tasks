# Copier ce fichier vers .env et adapter les valeurs

# --- Développement ---
# NB : sur macOS, éviter le port 5000 (occupé par le récepteur AirPlay)
PORT=5001
MONGO_URI=mongodb://localhost:27017/gmc_tasks
NODE_ENV=development

# Secret de signature des JWT — générer une valeur aléatoire, ex : openssl rand -hex 32
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire
JWT_EXPIRES_IN=7d

# --- Production ---
# NODE_ENV=production active : le service des fichiers React compilés,
# la restriction CORS et la confiance au reverse proxy.
#
# NODE_ENV=production
# PORT=5001
# MONGO_URI=mongodb://127.0.0.1:27017/gmc_tasks
#
# Origine(s) autorisée(s) à appeler l'API (séparées par des virgules).
# Inutile si le frontend est servi par Express (même origine).
# CLIENT_URL=https://tasks.synaptixonline.com
